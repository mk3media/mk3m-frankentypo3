## ==============================================================================
## Project & Compose Configuration
## ==============================================================================
COMPOSE_PROJECT_NAME=typo3-frankenphp

# Base storage path for persistent container data (defaults to ./data locally)
STORAGEPATH=./data

# Port exposed on the host machine
HTTP_PORT=8080
HTTPS_PORT=8443

# Host header used in Docker healthchecks and trusted host matching
APP_HOST=localhost

## ==============================================================================
## TYPO3 Application Settings
## ==============================================================================
# Context: Development | Production
TYPO3_CONTEXT=Development

# Trusted hosts pattern (regex)
TRUSTED_HOSTS_PATTERN=(localhost|127\.0\.0\.1|.*\.local)

# Resource limits for FrankenPHP / Go runtime
GOMAXPROCS=2
GOMEMLIMIT=768MiB

## ==============================================================================
## MariaDB Database Configuration
## ==============================================================================
MARIADB_ROOT_PASSWORD=super_secret_root_password
MARIADB_DATABASE=typo3
MARIADB_USER=typo3
MARIADB_PASSWORD=super_secret_db_password

## ==============================================================================
## Valkey (Redis-compatible) Cache Configuration
## ==============================================================================
VALKEY_PASSWORD=super_secret_valkey_password
